# The merchant example's variables, for all vibes space.
# scripts/configure-commerce-agents.sh copies this to the checkout's merchant/.env,
# keeping any value already filled in there. Secrets stay blank here: this file is committed.

# ── Which store ───────────────────────────────────────────────────────────────────────
# Leave SHOPIFY_LOCAL_STORE unset to run against the real store below. Set it to 1 to run
# against merchant/api/local_store.py instead — no account, no token, no network, and no
# way to touch the real catalog. Worth doing first.
# SHOPIFY_LOCAL_STORE=1

SHOPIFY_SHOP_DOMAIN=yxciec-f7.myshopify.com

# From the app's page in the Shopify Dev Dashboard. api/admin_token.py mints a 24-hour
# Admin token from these and mints another when it runs out, so nothing is pasted by hand.
# Treat the secret as a password for the store: it is a credential for every scope the app
# was granted. Fill in locally; never commit them.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The other way in: a shpat_… token minted elsewhere. Read only when the two above are
# empty, and it stops working 24 hours after it was minted.
SHOPIFY_ADMIN_TOKEN=

# Leave unset to use the version merchant/api/agent_config.py names.
SHOPIFY_ADMIN_API_VERSION=

# ── Either way ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Who the change ledger stamps on staged and applied changes. A real deployment reads this
# from its own authentication rather than from configuration.
SHOPIFY_OPERATOR=

SHOPIFY_STORE_NAME=all vibes space

# Stock is 10 per variant across the catalog, so the reference default of 8 would alert on
# a variant that has barely moved. 5 leaves room for a first sales week; raise it once
# real velocity is known. merchant/data/thresholds.json holds the per-type overrides.
SHOPIFY_LOW_STOCK_DEFAULT=5
SHOPIFY_FULFILMENT_SLA_DAYS=3

# 0 uses ShopifyQL where the token has read_reports, and says which source served a read.
SHOPIFY_DISABLE_SHOPIFYQL=0

# The approval gate. On, apply_change from a chat turn is held and the change moves only
# when the host calls POST /api/merchant/changes/{id}/apply. Keep it on against a live store.
MERCHANT_REQUIRE_HOST_APPROVAL=1
