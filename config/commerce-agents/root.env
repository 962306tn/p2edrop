# The storefront example's variables, for all vibes space.
# scripts/configure-commerce-agents.sh copies this to the checkout's .env, keeping any
# value already filled in there. Secrets stay blank here: this file is committed.

# The shop UCP discovery runs against. Use the storefront's primary domain if the store
# serves one; the myshopify domain is the fallback.
SHOP_DOMAIN=yxciec-f7.myshopify.com

# The agent's conversation model. Fill in locally; never commit it.
ANTHROPIC_API_KEY=

# Sign in with Shop — a Dev Dashboard app's credentials. Without the pair every session is
# a guest and the sign-in routes answer 503, which is a working configuration.
SHOPIFY_UCP_CLIENT_ID=
SHOPIFY_UCP_CLIENT_SECRET=

SHOP_OAUTH_REDIRECT_URI=http://localhost:8004/api/auth/shop/callback
WEB_APP_URL=http://localhost:3005

# Headless-dev shortcuts for storefront/scripts/smoke_signin.py.
SHOP_ACCESS_TOKEN=
SHOP_BUYER_IP=

# The hero's tagline when the shop has no slogan of its own.
BRAND_TAGLINE=Ask about scents, bundles, and what a refill actually covers.
CATALOG_WARMUP=1
