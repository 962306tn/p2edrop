# ===== Meta Ads CLI =====
# CLI chinh chu doc 2 bien duoi day tu file .env trong thu muc dang dung (cwd)
# hoac tu bien moi truong. Lay token bang System User trong Business Manager:
# Business Settings > Users > System users > Add > gan Admin cho ad account,
# page, pixel > Generate new token voi cac quyen:
#   ads_management, ads_read, business_management,
#   pages_show_list, pages_read_engagement, pages_manage_ads, read_insights
ACCESS_TOKEN=
AD_ACCOUNT_ID=act_

# Business ID (chi can cho cac lenh dataset/catalog)
BUSINESS_ID=

# ===== Dung trong ads/campaign.yaml qua cu phap ${TEN_BIEN} =====
PAGE_ID=
INSTAGRAM_USER_ID=
PIXEL_ID=
CONVERSION_DOMAIN=

# Phien ban Graph API dung cho preview (khong bat buoc)
# GRAPH_API_VERSION=v23.0
