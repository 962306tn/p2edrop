# Copy to .env (git-ignored) and fill in. pipeline/*.py reads this file
# automatically; real environment variables always win over it.

# Topview - both values come from the Topview dashboard under API Keys.
# The REST API is on the Pro and Business plans; Ultra and Team are MCP-only.
# Every request sends them as: Authorization: Bearer <key>  +  Topview-Uid: <uid>
TOPVIEW_API_KEY=
TOPVIEW_UID=

# Superscale needs nothing here: it has no REST API. Its MCP server signs you in
# over OAuth in the browser - see ./scripts/setup-superscale-mcp.sh
