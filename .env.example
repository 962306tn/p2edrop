# Copy to .env (git-ignored) and fill in. pipeline/*.py reads this file
# automatically; real environment variables always win over it.

# Topview - Settings -> API Keys in the Topview dashboard.
# The REST API is on the Pro and Business plans; Ultra and Team are MCP-only.
TOPVIEW_API_KEY=
TOPVIEW_UID=

# Superscale - only needed if you set superscale.enabled = true in
# pipeline/providers.json. Left empty the pipeline uses the hand-off files
# plus the generated assemble.sh instead.
SUPERSCALE_API_KEY=
